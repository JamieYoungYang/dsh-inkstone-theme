{
  "name": "dsh-inkstone-theme",
  "version": "1.1.7",
  "description": "Seven ink-wash palettes for DeepSeek Harness — 汝窑 赭石 松烟 青瓷 紫毫 宣纸 胭脂 — with a typeface layer (follow palette / sans / serif / mono), canvas gradients, and an audited contrast matrix.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "audit.mjs",
    "check-locale.mjs",
    "tokens.required.json",
    "cordis.patch.yml",
    "DESIGN.md",
    "README.md",
    "LICENSE",
    "icon.svg",
    "docs",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "author": "JamieYoungYang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamieYoungYang/dsh-inkstone-theme.git"
  },
  "homepage": "https://github.com/JamieYoungYang/dsh-inkstone-theme",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "theme",
    "palette",
    "color-scheme",
    "inkstone"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "audit": "node audit.mjs && node check-locale.mjs",
    "pack:check": "npm pack --dry-run",
    "release": "npm publish --access public --registry https://registry.npmjs.org"
  }
}
